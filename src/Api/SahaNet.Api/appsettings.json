{
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=sahanet;Username=sahanet;Password=sahanet_dev",
    "MaxRetryCount": 3,
    "ApplyMigrationsOnStartup": false
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Identity": {
    "OtpLength": 6,
    "OtpLifetime": "00:03:00",
    "OtpMaxAttempts": 5,
    "OtpResendCooldown": "00:01:00",
    "OtpMaxPerHour": 5,
    "RefreshTokenLifetime": "30.00:00:00",
    "AccountDeletionGracePeriod": "30.00:00:00",
    "SmsBrandName": "BalıkçıNet"
  },
  "Jwt": {
    "Issuer": "sahanet",
    "Audience": "sahanet-mobile",
    "AccessTokenLifetime": "00:15:00"
  },
  "RateLimiting": {
    "OtpPermitPerMinute": 10
  },
  "Alerts": {
    "WarningWindKmh": 39,
    "WarningGustKmh": 50,
    "WarningWaveM": 2.0,
    "CriticalWindKmh": 62,
    "CriticalGustKmh": 75,
    "CriticalWaveM": 3.5,
    "Lookahead": "1.00:00:00",
    "SmsFallbackForCritical": true,
    "DisplayTimeZone": "Europe/Istanbul"
  },
  "Weather": {
    "ForecastBaseUrl": "https://api.open-meteo.com/",
    "MarineBaseUrl": "https://marine-api.open-meteo.com/",
    "CacheDuration": "00:30:00"
  },
  "Push": {
    "Provider": "Logging",
    "AndroidCriticalChannelId": "critical_alerts",
    "AndroidDefaultChannelId": "alerts"
  },
  "Sms": {
    "Provider": "Logging",
    "Netgsm": {
      "BaseUrl": "https://api.netgsm.com.tr/"
    }
  },
  "BackgroundJobs": {
    "Enabled": true,
    "DashboardEnabled": false,
    "WeatherCheckCron": "*/30 * * * *",
    "AccountPurgeCron": "0 3 * * *",
    "RetentionCron": "30 3 * * *",
    "TimeZone": "Europe/Istanbul"
  },
  "Retention": {
    "OtpChallenges": "1.00:00:00",
    "InactiveRefreshTokens": "30.00:00:00",
    "AlertDeliveries": "90.00:00:00",
    "ExpiredAlerts": "365.00:00:00",
    "StaleDevices": "90.00:00:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}
