<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SahaNet.Mobile.Core.ViewModels;assembly=SahaNet.Mobile.Core"
             xmlns:api="clr-namespace:SahaNet.Mobile.Core.Api;assembly=SahaNet.Mobile.Core"
             xmlns:data="clr-namespace:SahaNet.Mobile.Core.Data;assembly=SahaNet.Mobile.Core"
             x:Class="SahaNet.Mobile.Views.ConversationsPage"
             x:DataType="vm:ConversationsViewModel"
             Title="Mesajlar">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Conversations}" SelectionMode="Single" SelectionChanged="OnSelected" Margin="16,0">
            <CollectionView.Header>
                <Label Text="{Binding StatusText}" Margin="0,12" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationItem">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="20" />
                            <Label Text="{Binding Preview}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding UnreadCount, StringFormat='🔵 {0}'}" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
