<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SahaNet.Mobile.Core.ViewModels;assembly=SahaNet.Mobile.Core"
             xmlns:api="clr-namespace:SahaNet.Mobile.Core.Api;assembly=SahaNet.Mobile.Core"
             xmlns:data="clr-namespace:SahaNet.Mobile.Core.Data;assembly=SahaNet.Mobile.Core"
             x:Class="SahaNet.Mobile.Views.ScrapPricesPage"
             x:DataType="vm:ScrapPricesViewModel"
             Title="Hurda fiyatları">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Prices}" SelectionMode="None" Margin="16,0">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="8" Padding="0,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding ProvinceCode}" Keyboard="Numeric" MaxLength="2" Placeholder="İl plaka kodu (ör. 34)" />
                        <Button Grid.Column="1" Text="Göster" Command="{Binding LoadCommand}" />
                    </Grid>
                    <Label Text="{Binding StatusText}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="api:ScrapPriceDto">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <VerticalStackLayout>
                            <Label Text="{Binding MaterialName}" FontAttributes="Bold" FontSize="20" />
                            <Label Text="{Binding Date, StringFormat='{0:dd MMMM}'}" FontSize="14" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Median, StringFormat='{0:0.00} ₺/kg'}" FontSize="22" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
